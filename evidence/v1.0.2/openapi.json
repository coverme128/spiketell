  "components": {
    "schemas": {
      "BrowserPresence": {
        "properties": {
          "client_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Client Id"
          },
          "visible": {
            "type": "boolean",
            "title": "Visible"
          },
          "browser_at": {
            "type": "string",
            "format": "date-time",
            "title": "Browser At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_id",
          "visible",
          "browser_at"
        ],
        "title": "BrowserPresence"
      },
      "EnabledRequest": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "EnabledRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportRequest": {
        "properties": {
          "symbols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Symbols"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbols"
        ],
        "title": "ImportRequest"
      },
      "ReceiptRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 16,
            "title": "Event Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PAGE_VISIBLE",
              "OS_SHOWN",
              "CLICKED"
            ],
            "title": "Kind"
          },
          "browser_at": {
            "type": "string",
            "format": "date-time",
            "title": "Browser At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "kind",
          "browser_at"
        ],
        "title": "ReceiptRequest"
      },
      "SettingsRequest": {
        "properties": {
          "quiet_mode": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quiet Mode"
          },
          "notification_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Enabled"
          },
          "max_watchlist": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Watchlist"
          },
          "retention_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 7.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Retention Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SettingsRequest"
      },
      "SourceConsent": {
        "properties": {
          "personal_use_confirmed": {
            "type": "boolean",
            "title": "Personal Use Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "personal_use_confirmed"
        ],
        "title": "SourceConsent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
