    {
      "id": "M109",
      "scenario": "out_of_session_event",
      "expected": "NO_ALERT",
      "check": "lunch/auction excluded"
    },
    {
      "id": "M110",
      "scenario": "late_backfill_event",
      "expected": "NO_LIVE_ALERT",
      "check": "never re-alert historical data"
    },
    {
      "id": "M111",
      "scenario": "low_amount_fast_rise",
      "expected": "NO_TRIGGER",
      "check": "amount <1000000 blocks signal"
    },
    {
      "id": "M112",
      "scenario": "unknown_bar_time_labels",
      "expected": "FAIL_CLOSED",
      "check": "no LIVE until timestamp meaning tested"
    },
    {
      "id": "M113",
      "scenario": "fifty_symbol_polling",
      "expected": "LIVE_GATE_REQUIRED",
      "check": "require measured >=95% coverage and p95<=45s"
    },
    {
      "id": "M114",
      "scenario": "restart_replay_duplicate",
      "expected": "NO_DUPLICATE_NOTIFICATION",
