    },
    {
      "id": "M103",
      "scenario": "three_minute_rising",
      "expected": "TRIGGER",
      "check": "ret3>=1.8 and final ret1>=0.3, continuous within session"
    },
    {
      "id": "M104",
      "scenario": "opening_first_bar_no_adjacent",
      "expected": "NO_TRIGGER",
      "check": "do not fabricate comparison to prior day"
    },
    {
      "id": "M105",
      "scenario": "cold_start_strong_price",
      "expected": "RAPID_MEDIUM",
      "check": "burst remains null and one RAPID_NEW"
    },
    {
      "id": "M106",
      "scenario": "cold_start_long_upper_wick",
      "expected": "NO_RAPID_OVERRIDE",
      "check": "no ungrounded rapid attention"
    },
    {
      "id": "M107",
      "scenario": "same_episode_reaccelerates",
      "expected": "SAME_CARD",
      "check": "one episode and no duplicate RAPID_NEW"
    },
    {
      "id": "M108",
      "scenario": "medium_rapid_to_high",
