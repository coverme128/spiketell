{
  "policy": "minute_only_v1.0.1",
  "data_mode": "SIMULATION",
  "note": "Scenario contract, not executable price fixtures. Codex must supply full synthetic MinuteBar fixtures and tests for each row.",
  "cases": [
    {
      "id": "M101",
      "scenario": "one_minute_fast_close_rise",
      "expected": "TRIGGER",
      "check": "Eligible price close change at least 1.8; no second-level claim"
    },
    {
      "id": "M102",
      "scenario": "intraminute_high_only_reversal",
      "expected": "DIAGNOSTIC_ONLY",
